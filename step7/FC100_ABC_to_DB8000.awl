// STEP 7 V5.7 - STL source (AWL-Quelle)
// Nhap vao: SIMATIC Manager > Sources > Insert New Object > External Source
// roi File > Compile. Doi so FC neu FC100 da duoc dung.
//
// Ghi chuoi 'ABC' vao DB8000.DBD0:
//   DBB0 = 'A' (16#41), DBB1 = 'B' (16#42), DBB2 = 'C' (16#43), DBB3 = 16#00

DATA_BLOCK DB 8000
TITLE = 'Text buffer'
VERSION : 0.1

  STRUCT
   Text_ABC : DWORD ;	// DBD0: 'A','B','C',00
  END_STRUCT ;
BEGIN
   Text_ABC := DW#16#0;
END_DATA_BLOCK

FUNCTION FC 100 : VOID
TITLE = Move 'ABC' to DB8000.DBD0
VERSION : 0.1

BEGIN
NETWORK
TITLE = 'ABC' -> DB8000.DBD0
// Dung hang so hex de thu tu byte ro rang:
// 41='A', 42='B', 43='C', 00 = byte cuoi (doi thanh 20 neu muon dau cach)
      L     DW#16#41424300; 
      T     DB8000.DBD    0; 
END_FUNCTION
